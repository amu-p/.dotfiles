// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": "file_finder::Toggle",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j j":    ["workspace::SendKeystrokes", "escape : w enter"],
      "ctrl-s": ["workspace::SendKeystrokes", "escape : w enter"],

      "ctrl-h": "vim::Left",
      "ctrl-j": "vim::Down",
      "ctrl-k": "vim::Up",
      "ctrl-l": "vim::Right",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "g w": "vim::HelixJumpToWord",
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }],
      "g j": ["vim::Down", { "display_lines": false }],
      "g k": ["vim::Up", { "display_lines": false }]
    },
  },
  {
    "context": "vim_mode == normal",
    "bindings": {
      "ctrl-s": ["workspace::SendKeystrokes", ": w enter"],
      "shift-h": ["workspace::SendKeystrokes", ": tabprev enter"],
      "shift-l": ["workspace::SendKeystrokes", ": tabnext enter"],
    },
  },
  {
    "context": "vim_mode == visual",
    "bindings": {
      "shift-s": "vim::PushAddSurrounds",
    },
  },
]
